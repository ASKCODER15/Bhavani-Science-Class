rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ardgamer113@gmail.com' ||
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/teachers/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.isOwner == true)
      );
    }

    function isTeacher() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email in ['ardgamer113@gmail.com', 'bhavaniteacher@gmail.com', 'faculty@bhavaniscience.edu'] ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email)) ||
        exists(/databases/$(database)/documents/approved_teachers/$(request.auth.token.email))
      );
    }

    // Active student check
    function isActiveStudent() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active') ||
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/students/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/students/$(request.auth.token.email)).data.status == 'active')
      );
    }

    // Connection health check document
    match /test/{docId} {
      allow read: if true;
    }

    // Teachers collection: faculty list readable, managed by super admin
    match /teachers/{teacherEmail} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Approved Teachers allowlist mirror
    match /approved_teachers/{teacherEmail} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Coaching Batches (public read for course overview)
    match /batches/{batchId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Academic Year configurations & rollover archive tracking
    match /academic_years/{yearId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Students collection: students can read only their own record. Never expose PII. Only teachers write.
    match /students/{studentId} {
      allow get: if isTeacher() || (isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        studentId == request.auth.uid ||
        studentId == request.auth.token.email
      ));
      allow list: if isTeacher() || (isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email
      ));
      allow write: if isTeacher();
    }

    // Fee records: students can read only their own fees, only teachers write
    match /fee_records/{feeId} {
      allow get: if isTeacher() || (isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email ||
        feeId == request.auth.uid
      ));
      allow list: if isTeacher() || (isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email
      ));
      allow write: if isTeacher();
    }

    // Test results: students can read only their own results, only teachers write
    match /test_results/{resultId} {
      allow get: if isTeacher() || (isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email
      ));
      allow list: if isTeacher() || (isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email
      ));
      allow write: if isTeacher();
    }

    // Lectures: syllabus video lessons catalog readable, only teachers write
    match /lectures/{lectureId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Weekly Timetables: schedule readable, only teachers write
    match /timetables/{timetableId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Notices & Holidays: institute bulletins readable, only teachers write
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Student Lecture Notes: students can read, create, update, delete their own notes
    match /student_notes/{noteId} {
      allow read, write: if isSignedIn() && (
        resource == null ||
        resource.data.studentEmail == request.auth.token.email ||
        resource.data.studentId == request.auth.uid
      );
    }
  }
}
